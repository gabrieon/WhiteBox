# WhiteBox environment example.
# Copy to .env.local (git-ignored) and adjust. All values are OPTIONAL — the
# app runs with sensible defaults. Never commit real secrets.

# Multiplayer Worker URL used by the browser client (src/sdk/multiplayer/client.js).
# Local dev default (npm run worker:dev) is ws://127.0.0.1:8787 — omit to use it.
# For a deployed Cloudflare Worker use the wss:// form, e.g.:
# VITE_MP_URL=wss://whitebox-mp.<your-subdomain>.workers.dev
VITE_MP_URL=ws://127.0.0.1:8787

# --- Auth -------------------------------------------------------------------
#
# Two supported modes. Clerk wins when its publishable key is present; without
# it the app falls back to the original Google Identity Services button, so the
# site keeps working either way.
#
# Clerk: https://dashboard.clerk.com → your app → API Keys → Publishable key.
# Must start with "pk_".
VITE_CLERK_PUBLISHABLE_KEY=

# Google: only used in the fallback path. Google Cloud Console → Credentials.
VITE_GOOGLE_CLIENT_ID=