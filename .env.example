# WhiteBox environment example.
# Copy to .env.local (git-ignored) and adjust. All values are OPTIONAL — the
# app runs with sensible defaults. Never commit real secrets.

# Multiplayer Worker URL used by the browser client (src/sdk/multiplayer/client.js).
# Local dev default (npm run worker:dev) is ws://127.0.0.1:8787 — omit to use it.
# For a deployed Cloudflare Worker use the wss:// form, e.g.:
# VITE_MP_URL=wss://whitebox-mp.<your-subdomain>.workers.dev
VITE_MP_URL=ws://127.0.0.1:8787

# --- Auth (Supabase) ------------------------------------------------------
# Supabase owns sessions and brokers Google / Apple / GitHub / email magic link.
# The sign-in UI is rendered by this app (src/components/SignIn.jsx), so there
# is no third-party badge or watermark on any plan.
#
# Find both values at https://supabase.com -> your project -> Settings -> API.
# VITE_SUPABASE_ANON_KEY takes the *publishable* key (sb_publishable_...), which
# is designed to ship in browser bundles. Never put the secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical host the OAuth round trip returns to. Leave unset in local dev (the
# app then uses whatever host the page is on, which is what you want on
# http://localhost:5173). Set it in production, and add the same URL to Supabase
# under Authentication -> URL Configuration -> Redirect URLs — Supabase ignores a
# redirect target that isn't allowlisted and silently falls back to the project's
# Site URL.
VITE_SITE_URL=

# --- Legacy Google fallback ------------------------------------------------
# Only used when the Supabase values above are empty, which falls the app back to
# Google Identity Services + an HttpOnly session cookie.
# Google Cloud Console -> APIs & Services -> Credentials.
VITE_GOOGLE_CLIENT_ID=
