    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
